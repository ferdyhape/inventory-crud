// This is your Prisma schema file,    
// learn more about it in the docs: https://pris.ly/d/prisma-schema    
    
generator client {    
  provider = "prisma-client-js"    
}    
    
datasource db {    
  provider = "postgresql" // Ganti ke postgresql sesuai dengan kebutuhan Anda    
  url      = env("DATABASE_URL")    
}    
    
model User {    
  id       Int    @id @default(autoincrement())    
  username String @unique    
  password String    
  name     String    
}    
  
model MasterBarang {    
  id          Int      @id @default(autoincrement())    
  namaBarang  String    
  kodeBarang  String   @unique    
  stok        Int    
  harga       Float    
  foto        String?    
  createdAt   DateTime @default(now())    
  updatedAt   DateTime @updatedAt  
  
  // Relasi dengan harga dan stok  
  hargaBarang  HargaBarang[]  
  stokBarang   StokBarang[]  
}    
  
model HargaBarang {  
  id             Int      @id @default(autoincrement())  
  masterBarangId Int  
  harga          String   // Varchar  
  tanggalBerlaku DateTime // Date  
  masterBarang   MasterBarang @relation(fields: [masterBarangId], references: [id])  
}  
  
model StokBarang {  
  id             Int      @id @default(autoincrement())  
  masterBarangId Int  
  tanggalBerlaku        DateTime // Date  
  stok           Int      // Integer  
  masterBarang   MasterBarang @relation(fields: [masterBarangId], references: [id])  
}  
